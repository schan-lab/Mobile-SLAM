<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the encrypted secrets cannot be decrypted on another device, so they are not backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secrets.xml" />
    </device-transfer>
</data-extraction-rules>
